flowchart LR
    API[public generation API] --> VALIDATE[bounded validation]
    VALIDATE --> ENTROPY[basis entropy]
    ENTROPY --> BASIS[hidden basis]
    BASIS --> PAD{padding accepted?}
    PAD -->|no| ENTROPY
    PAD -->|yes| IDENTIFIER[derived identifier]
    IDENTIFIER --> COLLISION{set-header collision?}
    COLLISION -->|yes| DISCARD[discard accepted basis]
    DISCARD --> ENTROPY
    COLLISION -->|no| SELECT[select output indices]
    SELECT --> OUT[immutable S and shares]
